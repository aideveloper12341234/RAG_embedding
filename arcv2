flowchart TB
    STARTDOC["START HERE · Document ingestion"]
    STARTRET["START HERE · Retrieval"]

    subgraph CORP["1 · Corporate / ViewPoint Environment"]
        direction LR
        VP["Dispatcher · ViewPoint"]
        DB[("ViewPoint DB<br/>Read-only context")]
        RESULT["Cited recommendations<br/>or manual escalation"]
    end

    subgraph HOST["2 · Azure Hosting Environment"]
        direction TB

        subgraph RUNTIME["PIPELINE B · Live retrieval and response"]
            APP["MAIN FASTAPI APPLICATION<br/>Azure Container App<br/>Authenticate + enrich alarm context<br/>Warm replicas · Autoscaling · Timeouts"]
            QUERY["Build retrieval query<br/>Alarm mapping + permission filters"]
            VALIDATE["Validate grounding + citations<br/>Insufficient evidence → escalate"]
            FALLBACK["Failure / timeout<br/>Continue existing ViewPoint workflow"]
            APP ==> QUERY
        end
    end

    subgraph AI["3 · Databricks AI & Knowledge Retrieval"]
        direction TB
        EMBED["Databricks Foundation Model API<br/>Document embeddings"]
        QEMBED["Databricks Foundation Model API<br/>Query embedding"]
        SEARCH[("Mosaic AI Vector Search<br/>Indexed chunks + vectors + metadata<br/>Hybrid search + access filters")]
        LLM["Databricks model serving · Proposed<br/>Generate from retrieved evidence"]
    end

    subgraph EDP["4 · EDP / DATABRICKS · DOCUMENT INGESTION"]
        direction TB
        DOCS["New / updated approved documents<br/>EDP knowledge interface"]
        subgraph INGEST["PIPELINE A · Daily document ingestion"]
            direction TB
            DAILY["Databricks Workflow / Job<br/>Daily scheduled run"]
            subgraph BT["TIER 1 · BRONZE · RAW"]
                BRONZE[("Raw documents + metadata<br/>Databricks volumes / Delta tables")]
            end
            subgraph ST["TIER 2 · SILVER · CLEANED"]
                PREP["Extract + chunk documents<br/>Preserve source, version + permissions"]
                SILVER[("Extracted and cleaned content<br/>Document chunks + metadata")]
            end
            subgraph GT["TIER 3 · GOLD · SEARCH READY"]
                STORE["Prepare chunks + vectors + metadata<br/>Update / delete stale index entries"]
                GOLD[("Search-ready chunks<br/>Embeddings + governed metadata")]
            end
        end
        MAP["Alarm-to-document mappings"]
        DATA["Governed alarm history<br/>Unity Catalog → Databricks → Power BI"]
    end

    subgraph SEC["5 · Identity, Security & Data Governance"]
        SECURITY["Entra ID · Managed identities · Key Vault<br/>Unity Catalog · Least privilege · Private connectivity<br/>Document permissions · Audit · Retention"]
    end

    subgraph OPS["6 · Monitoring, Operations & DevOps"]
        MON["Databricks monitoring · Azure Monitor · App Insights<br/>Latency · Cost · Index freshness · AI quality<br/>Daily job status + alerts"]
        DEPLOY["CI/CD · Infrastructure as code<br/>Rollback · Recovery targets + tests"]
    end

    DOCS ==>|"Daily ingestion"| DAILY
    DAILY ==> BRONZE
    BRONZE ==> PREP
    PREP ==> SILVER
    SILVER ==> EMBED
    EMBED ==> STORE
    STORE ==> GOLD
    GOLD ==>|"Sync search index"| SEARCH

    VP -->|"Alarm + attributes"| APP
    APP <-->|"Context · Bounded timeout"| DB
    MAP --> QUERY
    QUERY ==> QEMBED
    QEMBED ==>|"Vector + text query + filters"| SEARCH
    SEARCH ==>|"Relevant chunks + citations"| LLM
    LLM ==> VALIDATE
    VALIDATE ==>|"Validated recommendations"| RESULT
    APP --> FALLBACK
    VALIDATE -->|"Unsupported answer"| FALLBACK
    FALLBACK --> RESULT

    SECURITY -.-> APP
    SECURITY -.-> DAILY
    SECURITY -.-> BRONZE
    SECURITY -.-> SILVER
    SECURITY -.-> GOLD
    SECURITY -.-> SEARCH
    APP -.-> MON
    DAILY -.-> MON
    DEPLOY -.-> APP
    DEPLOY -.-> DAILY

    STARTDOC --> DOCS
    STARTRET --> VP

