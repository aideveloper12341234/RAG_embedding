# Copy to .env. Never commit the populated file.
# Temporary local vectors use a fixed identity; Azure settings remain inactive.
LOCAL_SEARCH_DB=.state/search.sqlite
LOCAL_SEARCH_TOP=5
# Azure settings below are inactive; retained for later migration.
AZURE_SEARCH_ENDPOINT=https://YOUR-SERVICE.search.windows.net
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_API_VERSION=2024-07-01
# Dedicated CK-27 alias, NOT an existing physical index name.
CK27_INDEX_ALIAS=ck27-live
AZURE_EMBEDDING_BASE_URL=https://YOUR-RESOURCE.openai.azure.com/openai/v1
AZURE_EMBEDDING_API_KEY=
AZURE_EMBEDDING_MODEL=
CK27_EMBEDDING_VERSION=
CK27_VECTOR_DIMENSIONS=
CK27_TOKEN_ENCODING=cl100k_base
CK27_MAX_TOKENS=2000
CK27_SOURCE_NAMESPACE=
CK27_STATE_DIR=.state
CK27_CHUNKS_PATH=app/document_processing/output/chunks.json
# Regex is deployment-specific; default supports examples such as P-101.
CK27_CODE_PATTERN=(?<![A-Za-z0-9_-])[A-Za-z][A-Za-z0-9]*-\d+[A-Za-z0-9]*(?![A-Za-z0-9_-])
# JSON mapping of required CK-18 names to dotted paths in each source chunk.
# Set these to your actual CK-18 fields before acceptance.
CK27_REQUIRED_METADATA={}
# The settings below belong to the disabled Azure reference implementation.
# Local results currently report match=unscored; these bands are not applied.
CK27_MATCH_HIGH=3.0
CK27_MATCH_MEDIUM=2.0
CK27_TIMEOUT_SECONDS=20
CK27_RETRIES=3
CK27_TOP=5
